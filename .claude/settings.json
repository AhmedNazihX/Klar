{
  "worktree": {
    "baseRef": "head"
  },
  "permissions": {
    "allow": [
      "Bash(uv run ruff check .)",
      "Bash(uv run ruff format --check .)",
      "Bash(uv run pyright)",
      "Bash(uv run pyright *)",
      "Bash(uv run pytest)",
      "Bash(uv run pytest *)",
      "Bash(uv run aiact deps check)",
      "Bash(uv run aiact --help)",
      "Bash(python3 .claude/scripts/backlog.py status)",
      "Bash(python3 .claude/scripts/backlog.py status *)",
      "Bash(python3 .claude/scripts/backlog.py show *)",
      "Bash(python3 .claude/scripts/backlog.py info *)",
      "Bash(python3 .claude/scripts/backlog.py deps *)",
      "Bash(git merge-base *)",
      "Bash(git sparse-checkout list)",
      "Bash(bash .claude/hooks/test-hooks.sh)",
      "Bash(supabase status)",
      "Bash(supabase migration list)",
      "Bash(supabase db advisors *)",
      "mcp__plugin_context7_context7__query-docs",
      "mcp__plugin_context7_context7__resolve-library-id"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/engine-gate.sh"
          }
        ]
      },
      {
        "matcher": "Read|Write|Edit|MultiEdit|NotebookEdit|Grep|Glob|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/isolation-guard.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/ruff-format.sh"
          }
        ]
      }
    ]
  }
}
