# Copy to backend/.env and fill in. Never commit backend/.env.
# Every key the app reads (aiact/settings.py). Empty values count as unset.

# Data: the shared legal-text folder. Defaults to <repo>/data; worktrees point it at the main checkout.
# A relative path is resolved against backend/, so ../data means <repo>/data from any directory.
AIACT_DATA_DIR=

# Model access (OpenRouter)
OPENROUTER_API_KEY=

# Database (Supabase: Postgres + pgvector)
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_KEY=
DATABASE_URL=

# Tracing (LangSmith): on only when the key is set. Empty AIACT_ENV means production: traces carry
# metadata only (no description, prompt, answer or error text). Set AIACT_ENV=development on your
# own machine only, to also trace the content; never in a deployed environment.
AIACT_ENV=
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=aiact

# Model ids: OpenRouter slugs, left empty until confirmed by X2 (engine model),
# X3 (OpenRouter routes) and X1 (embeddings). Intended models are from INIT > Tech stack.
# Decision 004 (X2): GPT-6 Luna, pinned version, e.g. openai/gpt-6-luna-20260922
ENGINE_MODEL=
# Decision 005: the engine model's EU ZDR endpoint, pinned with fallbacks off (e.g. azure/eu for Luna)
ENGINE_PROVIDER=
# Decision 033 (X2b): a request ENGINE_PROVIDER's content filter refuses goes once to this second
# model, pinned with fallbacks off: google/gemini-3.1-flash-lite on google-vertex/eu.
REFUSAL_MODEL=
REFUSAL_PROVIDER=
# tbc X2/X3: Jev
JUDGE_MODEL=
# tbc X2/X3: Claude Haiku 4.5
JUDGE_BACKUP_MODEL=
# tbc X2/X3: Claude Haiku 4.5
LABEL_FILTER_MODEL=
# RAGAS (V6). Empty = google/gemini-3.1-flash-lite on google-vertex/eu (decision 005). The provider is
# pinned with fallbacks off, so a different RAGAS_MODEL needs a RAGAS_PROVIDER that serves it.
RAGAS_MODEL=
RAGAS_PROVIDER=
# tbc X1/X3: Qwen3-Embedding-8B
EMBEDDING_MODEL=
# tbc X1/X3: Nebius (EU)
EMBEDDING_PROVIDER=
# Must match the vector(1536) column. Changing it needs a new migration and a full re-embed.
EMBEDDING_DIMENSIONS=1536
# Qwen3's query-side task text (X1a, decision 003). Empty = the default in aiact/settings.py.
# Changing it changes every query vector: re-record tests/recordings/db/test_search_ai_act/.
EMBEDDING_QUERY_INSTRUCTION=

# Search (C8): the meaning arm's cosine-distance cut-off (0..2) that Q&A and MCP searches apply,
# and the summed keyword IDF from which a keyword-only hit still counts as found. Empty = the
# defaults in aiact/settings.py, calibrated in X1b (decision 003).
SEARCH_MAX_DISTANCE=
SEARCH_MIN_KEYWORD_IDF=

# API (P1): `aiact api serve` listens on API_HOST:API_PORT (default 127.0.0.1:8000; keep the
# frontend's VITE_API_URL in step). CORS_ORIGINS: the browser origins allowed to call it,
# comma-separated, never "*" (default: the Vite dev server, http://localhost:5173 and
# http://127.0.0.1:5173). Empty = the defaults.
API_HOST=
API_PORT=
CORS_ORIGINS=
# API_ALLOWED_HOSTS: the Host headers the API answers, comma-separated, never "*" (default
# localhost,127.0.0.1; add the deployment's own host name).
API_ALLOWED_HOSTS=
# Client addresses from X-Forwarded-For only when API_PROXY_HEADERS=true and the proxy's address is
# in API_FORWARDED_ALLOW_IPS: explicit IPs or CIDRs, comma-separated, never "*" (default: off, and
# no proxy trusted).
API_PROXY_HEADERS=
API_FORWARDED_ALLOW_IPS=
# API_DOCS=false hides /docs, /redoc and /openapi.json (default true, for local development).
API_DOCS=
# The largest request body in bytes, refused with 413 (default 262144).
API_MAX_BODY_BYTES=
# Requests per client address per minute (default 5 classifications, 120 lookups, 10 Word or
# PDF exports).
RATE_LIMIT_CLASSIFY=
RATE_LIMIT_LOOKUPS=
RATE_LIMIT_EXPORTS=
# Word or PDF exports rendering at once; one more gets a 503 with Retry-After (default 2).
EXPORT_MAX_CONCURRENT=
# Seconds a Word or PDF file may take to render before it is stopped and refused (default 10).
EXPORT_TIMEOUT_SECONDS=
# Classifications running at once; one more gets a 503 with Retry-After (default 4).
CLASSIFY_MAX_CONCURRENT=
