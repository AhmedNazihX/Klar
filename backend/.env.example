# Copy to backend/.env and fill in. Never commit backend/.env.
# Every key the app reads (aiact/settings.py). Empty values count as unset.

# Data: the shared legal-text folder. Defaults to <repo>/data; worktrees point it at the main checkout.
AIACT_DATA_DIR=

# Model access (OpenRouter)
OPENROUTER_API_KEY=

# Database (Supabase: Postgres + pgvector)
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_KEY=
DATABASE_URL=

# Tracing (LangSmith, development only)
LANGSMITH_API_KEY=

# Model ids: OpenRouter slugs, to be confirmed by X2 (engine model), X3 (OpenRouter routes) and X1 (embeddings).
# INIT > Tech stack: engine GPT-6 Luna (version pinned); judge Jev, backup Claude Haiku 4.5;
# label filter Claude Haiku 4.5; RAGAS Gemini 3.1 Flash-Lite; embeddings Qwen3-Embedding-8B via Nebius (EU).
ENGINE_MODEL=<tbc X2/X3: GPT-6 Luna, pinned version>
JUDGE_MODEL=<tbc X2/X3: Jev>
JUDGE_BACKUP_MODEL=<tbc X2/X3: Claude Haiku 4.5>
LABEL_FILTER_MODEL=<tbc X2/X3: Claude Haiku 4.5>
RAGAS_MODEL=<tbc X2/X3: Gemini 3.1 Flash-Lite>
EMBEDDING_MODEL=<tbc X1/X3: Qwen3-Embedding-8B>
EMBEDDING_PROVIDER=<tbc X1/X3: Nebius>
EMBEDDING_DIMENSIONS=1536
