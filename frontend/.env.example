# Frontend settings. Copy to frontend/.env.local. Every VITE_* value is shipped in the public
# bundle, so never put a secret here: no OpenRouter key, no Supabase service-role key.

# The FastAPI backend (story P1). Defaults to http://localhost:8000 when unset.
VITE_API_URL=http://localhost:8000

# Supabase, for anonymous sessions. `supabase status` prints both values for the local stack
# (the URL is usually http://127.0.0.1:54321). Set both, or leave both empty to run the app
# without a session; setting only one is an error.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
