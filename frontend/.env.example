# Frontend settings. Copy to frontend/.env.local. Every VITE_* value is shipped in the public
# bundle, so never put a secret here: no OpenRouter key, no Supabase service-role key.

# The FastAPI backend (story P1). Defaults to http://localhost:8000 when unset.
VITE_API_URL=http://localhost:8000

# Supabase, for anonymous sessions: the hosted project in Frankfurt (decision 034). The URL is
# https://<ref>.supabase.co and the key is its publishable key (sb_publishable_..., public by
# design), both under the dashboard's Project Settings > API Keys. Set both, or leave both empty to
# run the app without a session; setting only one is an error.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
