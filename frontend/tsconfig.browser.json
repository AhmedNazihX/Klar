{
  // Browser-mode tests (*.browser.test.tsx, real Chromium) and their set-up, kept apart from the
  // jsdom tests because vitest/browser declares its own versions of the jest-dom matchers.
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.browser.tsbuildinfo",
    "types": ["vite/client"]
  },
  "include": ["src/**/*.browser.test.ts", "src/**/*.browser.test.tsx", "src/test/browser-setup.ts"],
  "exclude": []
}
