{
  // Tests and test helpers: the app settings plus Node types (tests may read files).
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.test.tsbuildinfo",
    "types": ["vite/client", "node"]
  },
  "include": ["src"],
  // Browser-mode tests have their own project: vitest/browser's matcher types clash with jest-dom's.
  "exclude": ["src/**/*.browser.test.ts", "src/**/*.browser.test.tsx", "src/test/browser-setup.ts"]
}
