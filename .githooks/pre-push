#!/bin/sh
# Refuses a push when docs/DEPENDENCIES.md is stale (story F8). It runs only the deps check.
# Enable once per clone: git config core.hooksPath .githooks
set -eu

cd "$(git rev-parse --show-toplevel)"

files="backend/pyproject.toml backend/uv.lock docs/DEPENDENCIES.md docs/dependency-licences.json"

# The check reads the working tree. With these files matching HEAD, it validates the commit.
# shellcheck disable=SC2086
if ! git diff --quiet HEAD -- $files; then
    echo "pre-push: push refused, uncommitted changes to the dependency files:" >&2
    # shellcheck disable=SC2086
    git diff --name-only HEAD -- $files >&2
    echo "Commit or stash them, then push again." >&2
    exit 1
fi

if ! uv run --frozen --quiet --project backend aiact deps check; then
    echo "pre-push: push refused, docs/DEPENDENCIES.md is stale." >&2
    echo "Run: uv run --project backend aiact deps generate, then commit" \
        "docs/DEPENDENCIES.md and docs/dependency-licences.json." >&2
    exit 1
fi
