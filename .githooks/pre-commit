#!/bin/sh
# Regenerates docs/DEPENDENCIES.md and stages it when backend/pyproject.toml or backend/uv.lock
# is staged (story F8). Enable once per clone: git config core.hooksPath .githooks
set -eu

cd "$(git rev-parse --show-toplevel)"

if ! git diff --cached --name-only | grep -Eq '^backend/(pyproject\.toml|uv\.lock)$'; then
    exit 0
fi

# --frozen: never re-lock during a commit; install from uv.lock as it is.
if ! uv run --frozen --quiet --project backend aiact deps generate >/dev/null; then
    echo "pre-commit: could not regenerate docs/DEPENDENCIES.md." >&2
    echo "Run: uv run --project backend aiact deps generate" >&2
    exit 1
fi
git add docs/DEPENDENCIES.md
